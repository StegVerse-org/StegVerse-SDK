+def _recorded_standing(receipt: Mapping[str, Any]) -> Mapping[str, Any]:
+    crossing = (receipt.get("evidence") or {}).get("crossing") or {}
+    standing = crossing.get("standing") if isinstance(crossing, Mapping) else None
