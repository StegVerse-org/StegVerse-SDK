{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/testing-data-loop.schema.json",
  "title": "StegVerse Testing Data Loop",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "intake_boundary",
    "dataset_manifest_hash",
    "intake_receipt_id",
    "loop_steps",
    "organization_ledger_receipt_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source": {
      "type": "string",
      "const": "human_requester"
    },
    "intake_boundary": {
      "type": "string",
      "enum": [
        "SDK",
        "LLM Adapter"
      ]
    },
    "dataset_manifest_hash": {
      "type": "string"
    },
    "intake_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "intake_receipt_hash": {
      "type": "string"
    },
    "loop_steps": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "actor",
          "action",
          "organization_ledger_receipt_required"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "receipt_type": {
            "type": "string"
          },
          "organization_ledger_receipt_required": {
            "type": "boolean",
            "const": true
          },
          "master_records_receipt_required": {
            "type": "boolean",
            "const": false,
            "$comment": "Master Records records released batch receipts downstream; never required."
          }
        },
        "additionalProperties": false
      }
    },
    "organization_ledger_receipt_required": {
      "type": "boolean",
      "const": true
    },
    "master_records_required": {
      "type": "boolean",
      "const": false,
      "$comment": "Master Records recording is optional, downstream and non-gating."
    }
  },
  "additionalProperties": false
}
