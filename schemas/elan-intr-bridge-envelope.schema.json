{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/elan-intr-bridge-envelope.schema.json",
  "title": "ELAN Interlock/InTr Bridge Envelope",
  "type": "object",
  "required": [
    "bridge_version",
    "transport_class",
    "source_framework",
    "source_event_id",
    "observed_at",
    "payload_sha256",
    "facts",
    "assertions",
    "interpretation_candidates",
    "resolution_state",
    "provenance"
  ],
  "properties": {
    "bridge_version": {"const": "elan.intr.bridge.v1"},
    "transport_class": {
      "enum": [
        "HUMAN_MEDIATED_EVIDENCE_EXCHANGE",
        "ELAN_SHAPED_SDK_SUBMISSION",
        "AUTHENTIC_ELAN_RUNTIME_SUBMISSION",
        "BIDIRECTIONAL_RUNTIME_INTEROPERABILITY"
      ]
    },
    "source_framework": {"type": "string", "minLength": 1},
    "source_instance_id": {"type": ["string", "null"]},
    "source_event_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    },
    "interpretation_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "resolution_state": {
      "enum": ["SINGLE_SURVIVING_INTERPRETATION", "UNRESOLVED_INTERPRETATION_SET"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "statement", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["id", "actor", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["id", "statement", "status", "elimination_reasons", "consequence_class"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["SURVIVING", "ELIMINATED"]},
        "elimination_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "consequence_class": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ELIMINATED"}}},
          "then": {"properties": {"elimination_reasons": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
