{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/sdk/evaluation-interest-request.schema.json",
  "title": "StegVerse SDK Evaluation Interest Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "objectives"],
  "properties": {
    "schema": {"const": "stegverse.sdk.evaluation-interest-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exclude_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maximum_interaction": {"enum": ["read_only", "deterministic_demo", "sandbox"]}
  }
}
